# Aasaan configuration. Copy to .env and fill in. Never commit real values.
# The app runs in live mode when GEMINI_API_KEY is set; otherwise it runs a clearly labelled mock/demo mode.
# Check everything with:  GET /api/health/models   (calls each configured model once)

# Force a mode: mock or live (empty = automatic)
AASAAN_MODE=
# SQLite file (single instance only). Empty = data/aasaan.db
AASAAN_DB=

# REQUIRED. Google AI Studio key. Serves gemma-4-26b-a4b-it and gemma-4-31b-it.
GEMINI_API_KEY=

# Optional. Indian-language chat (sarvam-105b, gemma4), speech to text, text to speech, translation.
# Docs: https://docs.sarvam.ai/llms.txt
SARVAM_API_KEY=

# Optional. Jev (TypeSafe) decision model: Diagnoser and Curator. Docs: https://docs.typesafe.ai/llms.txt
TYPESAFE_API_KEY=

# Optional. Resource finding (milestone 2): YouTube videos, stock images, page reading.
YOUTUBE_API_KEY=
PEXELS_API_KEY=
JINA_API_KEY=
FIRECRAWL_API_KEY=

# Optional extra Gemma fallback through OpenRouter.
OPENROUTER_API_KEY=
