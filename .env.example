# Aasaan configuration. Copy to .env and fill in. Never commit real values.
# The app runs in live mode when GEMINI_API_KEY is set; otherwise it runs a clearly labelled mock/demo mode.
# Check everything with:  GET /api/health/models  and  GET /api/health/tools   (keys are always shown masked)

# Force a mode: mock or live (empty = automatic)
AASAAN_MODE=
# SQLite file (single instance only). Empty = data/aasaan.db
AASAAN_DB=
# Protects /api/events and /api/admin/* (header X-Admin-Token). Set a long random value in production.
AASAAN_ADMIN_TOKEN=
# Put a URL or email here: it goes into the crawler's User-Agent so site owners can reach you.
AASAAN_CONTACT=

# --- models ---------------------------------------------------------------------------------------
# REQUIRED. Google AI Studio key. Serves gemma-4-26b-a4b-it and gemma-4-31b-it.
GEMINI_API_KEY=
# Extra Gemma 4 fallback, and a second route to Jev and Mercury Decide (the free decision model).
OPENROUTER_API_KEY=
# Jev (TypeSafe) decision model. Preferred over the OpenRouter route when both keys exist.
TYPESAFE_API_KEY=
# Indian-language chat (sarvam-105b, gemma4), speech to text, text to speech, translation.
SARVAM_API_KEY=

# --- web tools --------------------------------------------------------------------------------------
# YouTube Data API (video search). Without it, videos only come from Gemini Google Search grounding.
YOUTUBE_API_KEY=
# Jina Reader works without a key (rate limited); a key raises the quota.
JINA_API_KEY=
# Firecrawl: LAST page-reading tier and a discovery fallback only. Stops for the session after a 401/402.
FIRECRAWL_API_KEY=
FIRECRAWL_MAX_CALLS_PER_NOTEBOOK=20
# Openverse works anonymously (20/min, 200/day). Credentials (OAuth2 client credentials) raise the limits.
# NOTE: Openverse's docs do not name environment variables; these names are Aasaan's own choice.
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Per-notebook caps for free image sources
COMMONS_MAX_CALLS_PER_NOTEBOOK=12
OPENVERSE_MAX_CALLS_PER_NOTEBOOK=6

# --- visuals and testing -------------------------------------------------------------------------------
# Generated illustrations are OFF. If ever enabled: decorative art only, never diagrams with factual labels.
AASAAN_IMAGE_GEN=off
# Force failures to test fallbacks, e.g. "tool:commons=fail,model:jev=fail" (modes: fail, timeout, rate_limit, empty)
AASAAN_CHAOS=
